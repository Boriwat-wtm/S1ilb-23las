# คัดลอกเป็น .env แล้วเติมค่าจริง — .env ถูก gitignore ไว้แล้ว

# --- Neon Postgres ---
# เอามาจาก Neon dashboard > Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_DAYS=30

# --- CORS ---
# dev: localhost / prod: ใส่โดเมน Vercel อย่างเดียว
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase Storage (private bucket ชื่อ slips) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=slips
SIGNED_URL_TTL_SECONDS=3600
SLIP_MAX_EDGE_PX=1200
SLIP_JPEG_QUALITY=75

# --- OCR: อ่านสลิปเป็นข้อความ ---
# none = ปิดไว้ กรอกมือ | google = Google Cloud Vision
OCR_PROVIDER=none
GOOGLE_VISION_API_KEY=

# --- Tagger: เดาหมวดหมู่เฉพาะตอน keyword ไม่ตรง ---
# คำตอบถูกเขียนกลับเป็น keyword ค่าใช้จ่ายเลยลดลงเรื่อยๆ จนเกือบศูนย์
# none = ไม่เดา | gemini = Google Gemini
TAGGER_PROVIDER=none
GEMINI_API_KEY=
# ชื่อโมเดล เปลี่ยนได้เมื่อ Google เลิกใช้ตัวเดิม (อาการคือ 404)
GEMINI_MODEL=gemini-2.0-flash

# --- Display ---
APP_TIMEZONE=Asia/Bangkok

# --- seed script เท่านั้น ไม่ได้ใช้ตอน runtime ---
# user:ชื่อที่แสดง:รหัสผ่าน คั่นด้วย comma. ไม่ใส่ = สุ่มรหัสให้แล้วพิมพ์ออกมา
SEED_USERS=
